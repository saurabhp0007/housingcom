# Which build this is: development | preview | production (also the default OTA channel).
APP_VARIANT=development

# API base URL (inlined into the JS bundle). Use your LAN IP for a physical device.
EXPO_PUBLIC_API_URL=http://localhost:4000/api
# Google OAuth Web client ID (from Firebase console), used to get an ID token for Firebase.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Self-hosted OTA. Defaults to ${EXPO_PUBLIC_API_URL}/ota/manifest.
UPDATES_URL=
UPDATE_CHANNEL=
# OTA code signing: put the public certificate at apps/mobile/certs/certificate.pem (see docs/ota.md).

# Firebase native config files (downloaded from the Firebase console).
GOOGLE_SERVICES_JSON=./firebase/google-services.json
GOOGLE_SERVICES_PLIST=./firebase/GoogleService-Info.plist
GOOGLE_IOS_URL_SCHEME=

# Google Maps SDK key for Android (iOS uses Apple Maps via expo-maps; no key needed).
GOOGLE_MAPS_ANDROID_API_KEY=

# Expo push notifications need the EAS project id (expo.dev → project → ID).
EAS_PROJECT_ID=
# Real-time chat (Socket.IO). Defaults to the origin of EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_SOCKET_URL=
