# ── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api
# Public URL of this API; used to build OTA asset URLs when no CDN is configured.
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated origins allowed by CORS (e.g. the OTA console).
CORS_ORIGINS=http://localhost:4100

# ── Postgres (PostGIS) ────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=housing
DB_PASSWORD=housing
DB_NAME=housing
DB_SSL=false
DB_LOGGING=false

# ── Redis (cache + BullMQ) ────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ── Firebase Admin (verifies phone OTP / Google / Apple ID tokens) ──
# Leave the three below empty to use Application Default Credentials.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste with literal \n for newlines.
FIREBASE_PRIVATE_KEY=

# ── Object storage (OTA bundles, later listing media) ─
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
# CDN base URL in front of the bucket (optional). When set, clients download straight from it.
STORAGE_PUBLIC_BASE_URL=

# ── OTA updates ───────────────────────────────────────
# Bearer token for the OTA console / CLI uploads. Generate with: openssl rand -hex 32
OTA_ADMIN_TOKEN=change-me-to-a-long-random-ota-admin-token-0000
# PEM private key used to code-sign manifests (see docs/ota.md). Optional in development.
OTA_SIGNING_PRIVATE_KEY_PATH=
OTA_SIGNING_KEY_ID=main
OTA_MAX_UPLOAD_MB=100
# Auto-pause an update when crash rate >= this after at least OTA_AUTO_PAUSE_MIN_LAUNCHES launches.
OTA_AUTO_PAUSE_CRASH_RATE=0.2
OTA_AUTO_PAUSE_MIN_LAUNCHES=50

# ── Geo ───────────────────────────────────────────────
GEO_SERVICEABLE_RADIUS_KM=15
# Google Places API (New) key: landmark/college/office search and nearby metro/bus/college/hospital.
# Optional: without it, search covers our own areas and nearby places are skipped.
GOOGLE_PLACES_API_KEY=

# ── Push notifications (Expo) ─────────────────────
PUSH_ENABLED=true
# Only needed if "Enhanced push security" is enabled for the Expo project.
EXPO_ACCESS_TOKEN=

# ── Rate limiting ─────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
