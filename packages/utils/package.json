{
  "name": "@housingcom/utils",
  "version": "0.0.0",
  "private": true,
  "description": "Pure, platform-agnostic helpers shared by the API and the app.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@housingcom/tsconfig": "workspace:*",
    "typescript": "~6.0.3",
    "vitest": "^4.1.2"
  }
}
